msgid "One more step"
msgstr "Encore une étape"

#: templates/login-2fa.php:26
msgid "That code is not right, or it expired. Try the next one."
msgstr "Ce code n’est pas le bon, ou il a expiré. Essayez le suivant."

#: templates/login-2fa.php:28
msgid "Sent. Check your email."
msgstr "Envoyé. Regardez votre e-mail."

#: templates/login-2fa.php:36
msgid "The code"
msgstr "Le code"

#. translators: %d: days
#: templates/login-2fa.php:48
#, php-format
msgid "Do not ask again on this browser for %d days"
msgstr "Ne plus demander sur ce navigateur pendant %d jours"

#: templates/login-2fa.php:60
