msgstr "Ou utilisez :"

#: templates/login-2fa.php:88
msgid ""
"Lost the phone and the email? Use one of your backup codes: they go in the "
"same box."
msgstr ""
"Vous avez perdu le téléphone et l’e-mail ? Utilisez un de vos codes de "
"secours : ils vont dans la même case."

#: templates/login.php:22
msgid "Check your email"
msgstr "Regardez votre e-mail"

#: templates/login.php:23
msgid "We sent a sign-in link to"
msgstr "Nous avons envoyé un lien de connexion à"

#. translators: %d: how many minutes the link lasts
#: templates/login.php:29
#, php-format
msgid ""
"Click the link and you are in. It expires in %d minutes and works once."
msgstr ""
"Cliquez sur le lien et vous êtes entré. Il expire dans %d minutes et ne sert"
" qu’une fois."

#: templates/login.php:34
msgid "Did not arrive? Check your spam or promotions folder."
msgstr ""
"Il n’est pas arrivé ? Regardez dans les indésirables ou l’onglet promotions."

#: templates/login.php:41
msgid "That link expired or was already used. Ask for a new one."
msgstr "Ce lien a expiré ou a déjà été utilisé. Demandez-en un nouveau."

#: templates/login.php:43
msgid "That email address does not look valid."
msgstr "Cette adresse e-mail n’a pas l’air valide."

#: templates/login.php:45
msgid ""
"We could not finish signing you in with that provider. Try again or use your"
" email."
msgstr ""
"Nous n’avons pas pu terminer votre connexion avec ce fournisseur. Réessayez "
"ou utilisez votre e-mail."

#: templates/login.php:47
msgid "Something went wrong. Try again."
msgstr "Quelque chose s’est mal passé. Réessayez."

