msgstr "Desativado: não é oferecido"

#: includes/admin-2fa.php:162
msgid "With what"
msgstr "Com o quê"

#: includes/admin-2fa.php:158
msgid "To whom"
msgstr "Para quem"

#: includes/admin-2fa.php:179
msgid "Coming in by email link"
msgstr "Entrando pelo link por e-mail"

#: includes/admin-2fa.php:187
msgid "Work it out: ask, unless the second step is another email"
msgstr "Decidir: pedir, a menos que a segunda etapa seja outro e-mail"

#: includes/admin-2fa.php:194
msgid "Always ask"
msgstr "Pedir sempre"

#: includes/admin-2fa.php:201
