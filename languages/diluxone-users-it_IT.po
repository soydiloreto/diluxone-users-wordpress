msgstr "Permessi richiesti"

#: includes/admin-social.php:539
msgid "Authorization URL"
msgstr "URL di autorizzazione"

#: includes/admin-social.php:542
msgid "PKCE"
msgstr "PKCE"

#: includes/admin-social.php:543
msgid "Required by this provider. The plugin handles it; nothing to configure."
msgstr "Richiesto da questo provider. Se ne occupa il plugin; non c’è niente da configurare."

#: includes/admin-social.php:568
msgid "Run the live test"
msgstr "Lancia il test dal vivo"

#: includes/admin-social.php:569
msgid "Test it again"
msgstr "Testalo di nuovo"

#: includes/admin-social.php:589
msgid "Nothing loaded yet"
msgstr "Ancora niente caricato"

#: includes/admin-social.php:590
msgid "Create the app, load the redirect URL and paste the client ID and the secret in Settings."
msgstr "Crea l’app, carica la URL di ritorno e incolla il client ID e il secret in Impostazioni."

#: includes/admin-social.php:599
msgid "This needs to be tested"
msgstr "Questo va testato"

#. translators: %s: provider name
#: includes/admin-social.php:604
#, php-format
msgid "A window opens, %s asks you to authorise, and it comes back here. Nobody is signed in and nothing is saved to your account — it only checks that the round trip works. Until it does, the button cannot be enabled."
msgstr "Si apre una finestra, %s ti chiede di autorizzare, e torna qui. Non entra nessuno e non viene salvato niente sul tuo account — si controlla solo che l’andata e ritorno funzioni. Finché non funziona, il pulsante non si può attivare."

#: includes/admin-social.php:617
msgid "Tested and working"
msgstr "Testato e funzionante"

#: includes/admin-social.php:620
msgid "the button is showing on the sign-in page."
msgstr "il pulsante compare nella pagina di accesso."

#: includes/admin-social.php:621
msgid "the button is not showing: it is disabled."
msgstr "il pulsante non compare: è disattivato."

