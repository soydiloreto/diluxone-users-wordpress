msgstr "Il link di accesso conta sempre come «ricordami»: non c’è nessuna password da riscrivere."

#: includes/admin-sessions.php:165
msgid "In their account"
msgstr "Nel loro account"

#: includes/admin-sessions.php:206
#: includes/admin-sessions.php:208
