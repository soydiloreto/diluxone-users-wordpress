msgstr "La pagina scelta non esiste più."

#. translators: %s: title of the page
#: includes/admin-status.php:121
#, php-format
msgid "“%s” is not published, so nobody can reach it."
msgstr "«%s» non è pubblicata, quindi non ci arriva nessuno."

#: includes/admin-status.php:228
msgid "Account page"
msgstr "Pagina dell’account"

#: includes/admin-status.php:181
msgid "Outgoing mail"
msgstr "Posta in uscita"

#: includes/admin-status.php:190
msgid "The last message could not be sent."
msgstr "L’ultimo messaggio non è stato inviato."

#. translators: %s: how long ago, e.g. "2 hours"
#: includes/admin-status.php:203
#, php-format
msgid "Last message sent %s ago."
msgstr "Ultimo messaggio inviato %s fa."

#: includes/admin-status.php:244
msgid "The site is served over HTTPS."
msgstr "Il sito è servito via HTTPS."

#: includes/admin-status.php:250
msgid "Passkeys are on, but WebAuthn does not work outside HTTPS: nobody can register or use one."
msgstr "Le passkey sono attive, ma WebAuthn non funziona fuori da HTTPS: nessuno può registrarne o usarne una."

#: includes/admin-status.php:266
#: includes/admin-status.php:272
msgid "Permalinks"
msgstr "Permalink"

#: includes/admin-status.php:268
msgid "Set to “Plain”. The account area needs pretty permalinks to route its sections."
msgstr "Impostati su «Semplice». L’area account ha bisogno di permalink belli per instradare le sue sezioni."

#: includes/admin-status.php:276
#: includes/admin-status.php:278
msgid "Rewrite rules"
msgstr "Regole di riscrittura"

#: includes/admin-status.php:276
msgid "Up to date."
msgstr "Aggiornate."

#: includes/admin-status.php:315
